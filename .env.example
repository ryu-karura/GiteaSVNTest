# AI 実行用の環境変数テンプレート。
# コピーして <repo>/.env を作り、値を記入する（.env はコミット禁止）。
#   cp .env.example .env
#
# 読み込み順（後勝ち）: ~/.env → <repo>/.env
# 全プロジェクト共通の値は ~/.env に、プロジェクト固有の値はこの .env に置く。
#
# 使うサービスのブロックだけ埋めればよい（未使用のブロックは空のままで可）。
# どのタスクにどの変数が要るかは docs/ai/env-vars.md「タスク別の必要変数」を参照。
# Docker 試験環境の起動用は infra/.env.example（別物。混同しない）。
#
# 形式: KEY=value。値にスペースや # を含む場合は KEY="..." とする。

# ---- Gitea（PR 作成: REST API / curl）----
GITEA_BASE_URL=
GITEA_API_TOKEN=
GITEA_OWNER=
GITEA_REPO=

# ---- GitHub（PR 作成: REST API / curl）----
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# ---- Redmine（チケット作成・更新: REST API / curl）----
REDMINE_BASE_URL=
REDMINE_API_KEY=
REDMINE_PROJECT=

# ---- SVN（svn コマンド）----
SVN_BASE_URL=
SVN_USERNAME=
SVN_PASSWORD=

# ---- Git（git コマンド。Gitea への push 認証を含む）----
GIT_USERNAME=
GIT_PASSWORD=
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
