# ---- コピーして infra/.env を作成する。infra/.env はコミット禁止。----
# ここに置くのは「Docker 試験環境の起動用」の値（ポート・DB パスワード・管理者初期値など）。
#
# AI 実行時に参照する環境変数はこのファイルではない。
# リポジトリルートの .env.example をコピーして <repo>/.env を作り、docs/ai/env-vars.md に従う。
# 両者は別ファイル・別用途。混同しない。

# 公開ポート（ホスト側）
REDMINE_PORT=8080
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=2222
SVN1_PORT=8081
SVN2_PORT=8082

# Redmine / MariaDB
REDMINE_DB_NAME=redmine
REDMINE_DB_USER=redmine
REDMINE_DB_PASSWORD=redmine_pass
MARIADB_ROOT_PASSWORD=root_pass
# Redmine の API キーは Redmine 側で自動生成される（固定不可）。
# ブートストラップ（infra/README.md 手順2）が出力する 40hex を控えて
# seed 実行時に -e REDMINE_SEED_API_KEY=<その値> で渡す。
REDMINE_SEED_API_KEY=

# Gitea / Postgres
GITEA_DB_NAME=gitea
GITEA_DB_USER=gitea
GITEA_DB_PASSWORD=gitea_pass
POSTGRES_PASSWORD=gitea_pass
# 初期作成する Gitea 管理者
GITEA_ADMIN_USER=giteaadmin
GITEA_ADMIN_PASSWORD=giteaadmin_pass
GITEA_ADMIN_EMAIL=giteaadmin@example.com
# seed スクリプトで発行するトークン名
GITEA_SEED_TOKEN_NAME=ai-test-token

# SVN（両リポジトリ共通の初期ユーザー）
SVN_ADMIN_USER=svnuser
SVN_ADMIN_PASSWORD=svnpass

# Gitea Actions runner 登録トークン
# 取得: docker compose exec -u git gitea gitea actions generate-runner-token
GITEA_RUNNER_REGISTRATION_TOKEN=
